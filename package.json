{
  "name": "ai-certification-system",
  "version": "1.0.215",
  "author": "PJP",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 npx tsx server.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=electron/server.cjs",
    "build:publish": "npm run build && tsx scripts/post-build.js",
    "build:exe": "npm run build:publish && electron-builder --win",
    "bump-version": "tsx scripts/auto-version.ts --bump",
    "clean-db-versions": "tsx scripts/clean-db-versions.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); ['dist','dist-exe','publish','electron/server.cjs'].forEach(f=>{ fs.rmSync(f, {recursive:true, force:true}); })\"",
    "lint": "tsc --noEmit",
    "import-data": "tsx scripts/import-excel.ts"
  },
  "build": {
    "appId": "com.audit.ai.system",
    "productName": "AI 智能审核系统",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "publish/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI 智能审核系统"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/typography": "^0.5.20",
    "adm-zip": "^0.6.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.18.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "docx": "^9.6.1",
    "docx-preview": "^0.4.0",
    "docxtemplater": "^3.69.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "motion": "latest",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pizzip": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/file-saver": "^2.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "framer-motion": "^12.40.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.48.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
